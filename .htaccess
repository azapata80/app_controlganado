Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:docs|scripts|sql|tests)(?:/|$) - [F,L,NC]
</IfModule>

<FilesMatch "^(?:config(?:\.sample)?\.php|package(?:-lock)?\.json|VERSION)$|\.md$">
  Require all denied
</FilesMatch>

<FilesMatch "^\.env(?:\..*)?$">
  Require all denied
</FilesMatch>
